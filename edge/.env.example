# Copy to .env (gitignored) and fill in.
# Only these two vars are substituted into nginx/default.conf.template
# (see NGINX_ENVSUBST_FILTER in docker-compose.yml) — deliberately just these
# two, so the edge stack has no dependency on any project's own .env file.
DOMAIN=markusheuer.com
APP_DOMAIN=travelplanner.markusheuer.com
