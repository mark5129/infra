# nginx config template – processed by the nginx Docker image on startup.
# Only $DOMAIN and $APP_DOMAIN are substituted (NGINX_ENVSUBST_FILTER).
# All other nginx variables ($host, $uri, etc.) are passed through unchanged.
#
# This is the shared edge reverse proxy: it terminates TLS for every project
# on the box and is not owned by any one of them. Adding a new project means
# adding a server block here (and, if it needs a new upstream network, adding
# that network below as `external: true`) — not touching any project's own
# docker-compose file.
#
# Upstream hostnames are resolved dynamically (resolver + `set` + variable
# proxy_pass) instead of as plain `proxy_pass http://host:port` targets.
# Plain targets are resolved once, at nginx startup/config-test/reload time —
# if that specific project's container happens to be stopped at that moment
# (a dev/test environment that's intentionally down, a deploy mid-restart),
# nginx fails its config test with "host not found in upstream" and refuses
# to (re)start at all, taking every project behind this shared proxy down
# with it. The dynamic form only resolves per-request, so a stopped upstream
# just 502s for its own requests instead of breaking the whole stack.

resolver 127.0.0.11 valid=10s ipv6=off;

# Rate limiting zones
limit_req_zone $binary_remote_addr zone=api_general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=login_zone:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=register_zone:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=addr:10m;

# ── HTTP: ACME challenge + redirect (all domains) ────────────────────────────
server {
    listen      80;
    listen      [::]:80;
    server_name $DOMAIN www.$DOMAIN $APP_DOMAIN dev.$DOMAIN test.$DOMAIN renovationtracker.markusheuer.com loopifydemo.markusheuer.com meetup.markusheuer.com;

    limit_conn addr 10;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS: markusheuer.com – personal portfolio ───────────────────────────────
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name $DOMAIN www.$DOMAIN;

    limit_conn addr 10;

    ssl_certificate     /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options    "nosniff"                                      always;
    add_header X-Frame-Options           "SAMEORIGIN"                                   always;
    add_header X-XSS-Protection          "1; mode=block"                                always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"              always;

    location / {
        set $upstream_portfolio http://portfolio:3000;
        proxy_pass         $upstream_portfolio;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# ── HTTPS: TravelPlanner – Production ────────────────────────────────────────
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name $APP_DOMAIN;

    limit_conn addr 10;

    ssl_certificate     /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options    "nosniff"                                      always;
    add_header X-Frame-Options           "SAMEORIGIN"                                   always;
    add_header X-XSS-Protection          "1; mode=block"                                always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"              always;

    gzip            on;
    gzip_vary       on;
    gzip_proxied    any;
    gzip_comp_level 6;
    gzip_types      text/plain text/css text/xml application/json
                    application/javascript application/rss+xml
                    application/atom+xml image/svg+xml;

    location /media/ {
        set $upstream_tp_prod_media http://minio:9000/travelplanner/;
        proxy_pass $upstream_tp_prod_media;
        proxy_http_version 1.1;
        proxy_set_header Host minio:9000;
        proxy_set_header Authorization "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
    }

    location / {
        set $upstream_tp_prod_frontend http://frontend-prod:3000;
        proxy_pass         $upstream_tp_prod_frontend;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host               $host;
        proxy_set_header   X-Real-IP          $remote_addr;
        proxy_set_header   X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto  $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location = /api/auth/login {
        limit_req zone=login_zone burst=5 nodelay;
        limit_conn addr 10;
        set $upstream_tp_prod_backend http://backend-prod:8000;
        proxy_pass         $upstream_tp_prod_backend/auth/login;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        client_max_body_size 10M;
    }

    location = /api/auth/register {
        limit_req zone=register_zone;
        limit_conn addr 10;
        set $upstream_tp_prod_backend http://backend-prod:8000;
        proxy_pass         $upstream_tp_prod_backend/auth/register;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        client_max_body_size 10M;
    }

    location /api/ {
        limit_req zone=api_general burst=40 nodelay;
        limit_conn addr 10;
        client_max_body_size 10M;
        set $upstream_tp_prod_backend http://backend-prod:8000;
        proxy_pass         $upstream_tp_prod_backend/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

# ── HTTPS: Renovation Tracker – Production ────────────────────────────────────
# No Kong/Envoy gateway: path-based routing to /auth/v1, /rest/v1, /storage/v1
# replaces the Kong gateway a full Supabase stack would normally run, matching
# the approach documented in renovation-tracker's own docker-compose.yml.
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name renovationtracker.markusheuer.com;

    limit_conn addr 10;

    ssl_certificate     /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options    "nosniff"                                      always;
    add_header X-Frame-Options           "SAMEORIGIN"                                   always;
    add_header X-XSS-Protection          "1; mode=block"                                always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"              always;

    # GoTrue/PostgREST/storage-api all serve unprefixed routes (/health, not
    # /auth/v1/health) — a variable proxy_pass doesn't do the automatic
    # prefix-stripping a literal proxy_pass URI would, so it's done explicitly
    # here via rewrite before handing off to the (dynamically resolved) upstream.
    location /auth/v1/ {
        set $upstream_rt_auth http://auth:9999;
        rewrite ^/auth/v1/(.*)$ /$1 break;
        proxy_pass $upstream_rt_auth;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /rest/v1/ {
        set $upstream_rt_rest http://rest:3000;
        rewrite ^/rest/v1/(.*)$ /$1 break;
        proxy_pass $upstream_rt_rest;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /storage/v1/ {
        set $upstream_rt_storage http://storage:5000;
        rewrite ^/storage/v1/(.*)$ /$1 break;
        proxy_pass $upstream_rt_storage;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50M;
    }

    location / {
        set $upstream_rt_app http://renovation-tracker:3000;
        proxy_pass $upstream_rt_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

