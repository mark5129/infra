# ── HTTPS: Loopify – AI flow builder demo ────────────────────────────────────
# Single Next.js container, no API/storage split like renovation-tracker's:
# the demo keeps its flows in memory and calls the model from its own route
# handlers, so everything is served from one upstream.
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name loopifydemo.markusheuer.com;

    limit_conn addr 10;

    ssl_certificate     /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options    "nosniff"                                      always;
    add_header X-Frame-Options           "SAMEORIGIN"                                   always;
    add_header X-XSS-Protection          "1; mode=block"                                always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"              always;

    location / {
        set $upstream_loopify http://loopify:3000;
        proxy_pass         $upstream_loopify;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Flow generation is a model call that can run well past nginx's 60s
        # default; without this the browser gets a 504 while the request is
        # still in flight upstream.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}

# ── HTTPS: MeetupMVP ─────────────────────────────────────────────────────────
# Next.js web app plus a separate Fastify API, both on meetupmvp_web-meetup.
# /api/ is stripped before reaching meetup-api (its routes have no /api prefix),
# via rewrite because a variable proxy_pass doesn't strip the prefix itself.
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name meetup.markusheuer.com;

    limit_conn addr 10;

    ssl_certificate     /etc/letsencrypt/live/$DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$DOMAIN/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options    "nosniff"                                      always;
    add_header X-Frame-Options           "SAMEORIGIN"                                   always;
    add_header X-XSS-Protection          "1; mode=block"                                always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"              always;

    location /api/ {
        limit_req zone=api_general burst=40 nodelay;
        # Photo uploads (MeetupMVP #23) allow up to 10 MB per file; 12m leaves
        # headroom for multipart overhead over nginx's 1 MB default.
        client_max_body_size 12m;
        # set must come before rewrite: `break` stops the rest of the rewrite
        # module's directives (set included) from running in this location.
        set $upstream_meetup_api http://meetup-api:4000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass         $upstream_meetup_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location / {
        set $upstream_meetup http://meetup:3000;
        proxy_pass         $upstream_meetup;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
